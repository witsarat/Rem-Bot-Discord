# ============================================================
#  ⚙️ ไฟล์ตั้งค่าบอท Discord (Voice Log Bot)
#  วิธีใช้: คัดลอกไฟล์นี้เป็น .env แล้วแทนค่า
#  "DISCORD_TOKEN_HERE" และ "CLIENT_ID_HERE" ด้วยค่าจริงของบอทคุณ
#  (ห้าม commit ไฟล์ .env ขึ้น Git เด็ดขาด!)
# ============================================================

# ── 1) Token ของบอท ──────────────────────────────────────────
# หาได้จาก: https://discord.com/developers/applications
#            → เลือก Application ของคุณ → เมนู Bot → Reset Token → Copy
DISCORD_TOKEN=DISCORD_TOKEN_HERE

# ── 2) Client ID (Application ID) ───────────────────────────
# หาได้จาก: หน้า General Information ของ Application → Application ID
CLIENT_ID=CLIENT_ID_HERE

# ── 3) (ไม่บังคับ) Server ID สำหรับให้คำสั่งขึ้นทันที ──
# ใส่ได้หลายเซิร์ฟเวอร์ คั่นด้วย , เช่น 111...,222...
# ใส่แล้ว  : คำสั่ง /setup /help ขึ้นทันทีในเซิร์ฟเวอร์ที่ระบุ (หลังรัน npm run deploy)
# ไม่ใส่   : ยังใช้ได้ทุกเซิร์ฟเวอร์ (โหมด Global — เซิร์ฟเวอร์ใหม่อาจรอถึง ~1 ชม.)
# หาได้จาก: เปิด Developer Mode ใน Discord → คลิกขวาชื่อเซิร์ฟเวอร์ → Copy Server ID
GUILD_ID=GUILD_ID_HERE
