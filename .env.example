# ============================================================
#  ⚙️ ไฟล์ตั้งค่าบอท Discord (Voice Log Bot)
#  วิธีใช้: คัดลอกไฟล์นี้เป็น .env แล้วแทนค่า
#  "DISCORD_TOKEN_HERE" และ "CLIENT_ID_HERE" ด้วยค่าจริงของบอทคุณ
#  (ห้าม commit ไฟล์ .env ขึ้น Git เด็ดขาด!)
# ============================================================

# ── 1) Token ของบอท ──────────────────────────────────────────
# หาได้จาก: https://discord.com/developers/applications
#            → เลือก Application ของคุณ → เมนู Bot → Reset Token → Copy
DISCORD_TOKEN=DISCORD_TOKEN_HERE

# ── 2) Client ID (Application ID) ───────────────────────────
# หาได้จาก: หน้า General Information ของ Application → Application ID
CLIENT_ID=CLIENT_ID_HERE

# ── 3) (ไม่บังคับ) Server ID เสริมสำหรับให้คำสั่งขึ้นทันที ──
# ปกติไม่ต้องใส่ก็ได้ — npm run deploy ลงคำสั่งให้ทุกดิสที่บอทอยู่ให้เองอัตโนมัติ
# ใส่ได้หลายเซิร์ฟเวอร์ คั่นด้วย , เช่น 111...,222...
# หาได้จาก: เปิด Developer Mode ใน Discord → คลิกขวาชื่อเซิร์ฟเวอร์ → Copy Server ID
GUILD_ID=GUILD_ID_HERE

# ── 4) (ไม่บังคับ) ฐานข้อมูลออนไลน์ PostgreSQL — เช่น Supabase (ฟรี) ──
# ใส่แล้ว  : บอทเก็บ "ค่าห้อง log" + "ประวัติ voice log" ลง DB → อยู่ถาวรแม้ deploy ใหม่
# ไม่ใส่   : เก็บลงไฟล์ config.json ในเครื่อง (บน Render จะหายทุกครั้งที่ deploy)
# วิธีเอา  : supabase.com → New Project → ปุ่ม Connect → Connection pooling (Transaction) → Copy URI
DATABASE_URL=

# ── 5) (ไม่บังคับ) Spotify — สำหรับ /play กับลิงก์ Spotify ──
# วิธีเอา: developer.spotify.com → Create app (ฟรี) → Settings → คัดลอก Client ID / Client Secret
# ไม่มีก็ใช้ได้ — จะใช้ไม่ได้เฉพาะ "ลิงก์ Spotify" (เพลงจาก YouTube/ค้นหาปกติใช้ได้เลย)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── 6) (ไม่บังคับ) ที่อยู่ไฟล์ yt-dlp (ถ้าต้องการชี้เอง) ──
# ปกติไม่ต้องใส่ — บอทติดตั้งที่ bin/yt-dlp ให้อัตโนมัติตอน npm install
# YTDLP_PATH=
