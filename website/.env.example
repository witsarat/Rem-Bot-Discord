# ── ตัวอย่างไฟล์ env ของเว็บไซต์ ──
# วิธีใช้: คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าให้ครบ
# (บน Vercel: ใส่ค่าเดียวกันใน Project → Settings → Environment Variables)

# ── Discord OAuth (สำหรับปุ่ม "เข้าสู่ระบบด้วย Discord") ──
# เอา Client ID / Client Secret จาก: discord.com/developers/applications → แอปบอท → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── โทเคนบอท (ใช้ดึงรายชื่อห้องในเซิร์ฟเวอร์เพื่อทำ dropdown ตั้งค่า) ──
DISCORD_TOKEN=

# ── ฐานข้อมูลเดียวกับบอท (Supabase → Connection pooling) ──
DATABASE_URL=

# ── คีย์สำหรับเซ็นเซสชัน login ของเว็บ ──
# สุ่มด้วย: openssl rand -hex 32
SESSION_SECRET=
