{
  "name": "voice-log-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Discord Voice Log Bot — บันทึกการเข้า-ออก-ย้ายห้องเสียงด้วย TypeScript + discord.js v14",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "start:prod": "node dist/index.js",
    "deploy": "tsx src/deploy-commands.ts",
    "diagnose": "node diagnose.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
